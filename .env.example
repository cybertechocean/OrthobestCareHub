# ==============================================================================
# ORTHOBEST CARE HUB — PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# Domain: orthobestcarehub.co.ke | Shared Hosting (cPanel / Passenger)
# Path: /home2/genzcons/orthobestcarehub.co.ke/.env
# Python: 3.12 (3.12.13)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SECURITY
# ------------------------------------------------------------------------------
# Set DEBUG to False in production
DEBUG=False

# Generate a strong 50+ character random secret key for production
# You can generate one via: python -c 'import secrets; print(secrets.token_urlsafe(50))'
SECRET_KEY=django-secure-production-secret-key-orthobestcarehub-kenya-2026-xyz

# Allowed domain names
ALLOWED_HOSTS=orthobestcarehub.co.ke,www.orthobestcarehub.co.ke,localhost,127.0.0.1

# CSRF Trusted Origins for HTTPS form submissions
CSRF_TRUSTED_ORIGINS=https://orthobestcarehub.co.ke,https://www.orthobestcarehub.co.ke

# Automatically redirect HTTP to HTTPS (set to False only if SSL is handled upstream)
SECURE_SSL_REDIRECT=True

# ------------------------------------------------------------------------------
# 2. MARIADB / MYSQL DATABASE (cPanel / Shared Hosting)
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.mysql
# Note: On cPanel under user 'genzcons', the database name and user are usually prefixed:
DB_NAME=genzcons_orthobestcare
DB_USER=genzcons_orthobestuser
DB_PASSWORD=your_secure_mariadb_password_here
DB_HOST=localhost
DB_PORT=3306

# Alternatively, single URL connection string:
# DATABASE_URL=mysql://genzcons_orthobestuser:your_password@localhost:3306/genzcons_orthobestcare

# ------------------------------------------------------------------------------
# 3. DATABASE CACHE CONFIGURATION (createcachetable)
# ------------------------------------------------------------------------------
CACHE_TABLE=orthobest_cache_table
CACHE_TIMEOUT=300
CACHE_MAX_ENTRIES=5000

# ------------------------------------------------------------------------------
# 4. EMAIL BACKEND CONFIGURATION (SMTP)
# ------------------------------------------------------------------------------
# Option A: cPanel Webmail (info@orthobestcarehub.co.ke) - RECOMMENDED
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.orthobestcarehub.co.ke
EMAIL_PORT=465
EMAIL_HOST_USER=info@orthobestcarehub.co.ke
EMAIL_HOST_PASSWORD=your_cpanel_email_password_here
EMAIL_USE_TLS=False
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL="Orthobest Care Hub <info@orthobestcarehub.co.ke>"

# Option B: Gmail SMTP (orthobestcarehub@gmail.com with Google App Password)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=orthobestcarehub@gmail.com
# EMAIL_HOST_PASSWORD=your_16_character_google_app_password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL="Orthobest Care Hub <orthobestcarehub@gmail.com>"

# ------------------------------------------------------------------------------
# 5. KENYAN M-PESA DARAJA API PAYMENT INTEGRATION
# ------------------------------------------------------------------------------
MPESA_ENVIRONMENT=live
MPESA_CONSUMER_KEY=your_live_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_live_daraja_consumer_secret
MPESA_PASSKEY=your_live_daraja_passkey
MPESA_SHORTCODE=your_till_or_paybill_number
MPESA_CALLBACK_URL=https://orthobestcarehub.co.ke/payments/mpesa/callback/

# ------------------------------------------------------------------------------
# 6. BUSINESS & SITE IDENTITY
# ------------------------------------------------------------------------------
SITE_NAME="Orthobest Care Hub"
SITE_DOMAIN=orthobestcarehub.co.ke
OLD_DOMAIN=orthobestcarerehab.co.ke
SITE_PHONE="+254 719 160 398"
SITE_PHONE_ALT="+254 727 480 198"
WHATSAPP_NUMBER="254798246811"
CONTACT_EMAIL=info@orthobestcarehub.co.ke
CONTACT_EMAIL_ALT=orthobestcarehub@gmail.com
PHYSICAL_ADDRESS="Mfangano Street, Travis Building, 3rd Floor, Room C37, Wing C, Nairobi CBD, Kenya"

# ------------------------------------------------------------------------------
# 7. ANALYTICS & PIXELS (Optional)
# ------------------------------------------------------------------------------
GOOGLE_ANALYTICS_ID=
META_PIXEL_ID=
